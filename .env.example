# development o production. En production el servidor no arranca sin las credenciales de envío.
NODE_ENV=development
PORT=3000
# Token que tú inventas y pegas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-este-token
# App Secret de tu app en Meta (para validar la firma de cada mensaje)
WHATSAPP_APP_SECRET=
# Token de acceso y Phone Number ID para responder. Si faltan (y NODE_ENV no es production),
# el bot corre en modo ensayo: registra en consola el tipo de mensaje, sin llamar a Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API. Consulta las vigentes y su fecha de retiro en
# https://developers.facebook.com/docs/graph-api/changelog
WHATSAPP_API_VERSION=v27.0
# Aviso al local cuando un cliente pide hablar con una persona: POST JSON a esta URL
# (Slack, Discord, n8n, Make...). Debe ser https y del propio restaurante: incluye el
# teléfono del cliente, que es un dato personal. Vacío = sin aviso.
HANDOFF_WEBHOOK_URL=
# Intérprete de texto libre (pedidos como "dos perros, uno sin cebolla"). Sin clave, el bot
# entiende solo botones y texto simple. Se envía a Anthropic el texto del mensaje, el paso y el
# carrito (nunca el teléfono ni el nombre): menciónalo en el aviso de privacidad (Ley 1581).
# La clave se crea en https://platform.claude.com (API keys) y se cobra con los créditos de esa
# cuenta, no con tu plan de Claude. Para no tener cargos sorpresa: créditos prepagados y la
# recarga automática apagada. Este archivo .env nunca se sube al repositorio (.gitignore).
ANTHROPIC_API_KEY=
# Modelo y esfuerzo. Mide cualquier cambio con `npm run evaluar -- claude` antes de usarlo.
# AI_MODEL empieza con claude-; AI_EFFORT es low, medium, high, xhigh o max. Si no, no arranca.
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# Tope de llamadas a la IA por día (calendario en la zona del restaurante). Al pasarlo, el bot
# sigue solo con reglas. Se cuenta en memoria y por proceso: un reinicio lo pone en cero.
# Además, cada cliente tiene un límite de 10 llamadas cada 10 minutos.
# 50 es un valor seguro para probar. El peor día cuesta este tope por el costo máximo de una
# llamada (costo máximo de `npm run evaluar -- claude`, sin --confirmar, dividido por sus llamadas).
# Súbelo según el tráfico real del local cuando lo pongas en producción (sin esta línea, el tope es 2000).
AI_DAILY_LIMIT=50
DB_PATH=data/restobot.db
# Si no existe config/restaurant.json se usa el de ejemplo
RESTAURANT_CONFIG=config/restaurant.json
