PORT=3000
# Token que tú inventas y pegas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-este-token
# App Secret de tu app en Meta (para validar la firma de cada mensaje)
WHATSAPP_APP_SECRET=
# Token de acceso y Phone Number ID (se usan desde la fase 2 para responder)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
DB_PATH=data/restobot.db
# Si no existe config/restaurant.json se usa el de ejemplo
RESTAURANT_CONFIG=config/restaurant.json
